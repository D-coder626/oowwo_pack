{
  "experience_per_level": {
    "type": "expression",
    "data": {
      "expression": "40 + 12 * level"
    }
  },
  "level_limit": 30,
  "sources": [
    {
      "type": "puffish_skills:kill_entity",
      "data": {
        "variables": {
          "max_health": {
            "operations": [
              {
                "type": "get_killed_living_entity"
              },
              {
                "type": "get_max_health"
              }
            ]
          },
          "melee": {
            "operations": [
              {
                "type": "get_damage_source"
              },
              {
                "type": "puffish_skills:is_melee"
              }
            ]
          },
          "projectile": {
            "operations": [
              {
                "type": "get_damage_source"
              },
              {
                "type": "puffish_skills:is_projectile"
              }
            ]
          },
          "magic": {
            "operations": [
              {
                "type": "get_damage_source"
              },
              {
                "type": "puffish_skills:is_magic"
              }
            ]
          }
        },
        "experience": [
          {
            "condition": "(melee | projectile) & !magic",
            "expression": "max(1, max_health / 4)"
          }
        ],
        "anti_farming_per_chunk": {
          "limit_per_chunk": 15,
          "reset_after_seconds": 300
        }
      }
    }
  ]
}
